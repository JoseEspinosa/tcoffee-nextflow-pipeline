/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running M-Coffee mode tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    using M-Coffee, which aligns sequences by combining the output of popular aligners.

    Use as follows:
        nextflow run crg/tcoffee -profile test_mcoffee,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '30.m'
    ]
}

params {
    config_profile_name        = 'Test M-Coffee profile'
    config_profile_description = 'Minimal test dataset to check M-Coffee mode (5 hemoglobin alpha sequences)'

    // Input: samplesheet pointing to the shared test FASTA (same file used by the T-Coffee server tests)
    input  = "${projectDir}/assets/samplesheet_mcoffee.csv"

    // M-Coffee mode: combines output of multiple aligners
    mode          = 'mcoffee'
    output_format = 'clustalw_aln'
    maxnseq       = 10
    maxlen        = 1000
}
