/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Expresso mode tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    using Expresso, which aligns protein sequences guided by 3D structural information.

    Use as follows:
        nextflow run crg/tcoffee -profile test_expresso,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '30.m'
    ]
}

params {
    config_profile_name        = 'Test Expresso profile'
    config_profile_description = 'Minimal test dataset to check Expresso mode (5 SH2-domain sequences with PDB IDs as names)'

    // Input: 5 SH2-domain sequences named with PDB IDs (1aboA, 1ycsB, 1pht, 1vie, 1ihvA)
    input    = "${projectDir}/assets/samplesheet_expresso.csv"

    // SAP structural alignment with a pre-built template list (bypasses online BLASTP)
    method   = 'sap_pair'
    template = "${projectDir}/assets/sample_expresso.template_list"

    output_format = 'clustalw_aln'
    maxnseq       = 10
    maxlen        = 1000
}
