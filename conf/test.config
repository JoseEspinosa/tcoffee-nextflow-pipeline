/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run crg/tcoffee -profile test,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '30.m'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function (5 SH2-domain sequences)'

    // Input: samplesheet with one sample pointing to the bundled test FASTA
    input  = "${projectDir}/assets/samplesheet.csv"

    // Use default T-Coffee regular mode with minimal outputs
    mode          = 'regular'
    output_format = 'clustalw_aln'
    // output_format = 'fasta_aln'
    maxnseq       = 10
    maxlen        = 1000
}
